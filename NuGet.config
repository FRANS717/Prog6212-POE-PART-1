<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore only from nuget.org so the project builds the same on any machine and in GitHub Actions. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
